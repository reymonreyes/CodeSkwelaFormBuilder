@page "/"
@using System.Text.Json
@using CodeSkwelaFormBuilder.Blazor.Components.FormControls
@using CodeSkwelaFormBuilder.Blazor.Shared
@using CodeSkwelaFormBuilder.Blazor.Shared.Models
@using ViewModels = CodeSkwelaFormBuilder.Blazor.Shared.ViewModels

@inject IDatabase Database

<PageTitle>Blazor Form Builder</PageTitle>

<MudGrid>
    <MudItem sm="3" md="3" lg="3">
        <MudPaper Class="my-1">
            <MudToolBar>
                <MudIconButton OnClick="AddForm" Icon="@Icons.Material.Outlined.Add" />
                <MudIconButton OnClick="SaveForm" Icon="@Icons.Material.Outlined.Save" />
            </MudToolBar>
        </MudPaper>
        <MudPaper>
            <MudList T="Form" SelectedValueChanged="LoadForm">
                @foreach (var form in _formsList)
                {
                    <MudListItem Value="form" Text="@form.Name" />
                }
            </MudList>
        </MudPaper>
        <MudList T="string">
            <MudListItem Text="Textbox" Icon="@Icons.Material.Filled.Input" OnClick="AddTextbox" />
        </MudList>
    </MudItem>
    <MudItem sm="9" md="9" lg="9">
        @if(_form.Controls != null && _form.Controls.Count > 0){
            @foreach (var control in _form.Controls)
            {
                <MudStack>                
                    <DynamicComponent Type="@Type.GetType(control.Type)" Parameters="control.Parameters" @ref="control.ControlReference" />
                </MudStack>
            }
        }        
    </MudItem>
</MudGrid>

@code{

    private List<Type> formElements = new List<Type>();
    private List<ViewModels.Form> _forms = new List<ViewModels.Form>();
    private ViewModels.Form? _form;
    private List<Form> _formsList = new List<Form>();
    private List<DynamicComponent> _formControlReferences = new List<DynamicComponent>();

    protected override void OnInitialized()
    {
        GetFormsList();

        if (_formsList.Count == 0)
            AddForm();
    }

    private void GetFormsList()
    {
        _formsList = Database.GetAllForms();
    }

    private void AddTextbox()
    {       
        _form.Controls.Add(new ViewModels.FormControl
        {
            Id = Guid.NewGuid(),
            FormId = _form.Id,
            Type = "CodeSkwelaFormBuilder.Blazor.Components.FormControls.TextInput",
            Parameters = new Dictionary<string, object>{
                { "Label", "Label here..." },
                { "Value", "some value" }
            }
        });
        _formControlReferences.Add(new DynamicComponent());
    }

    private void SaveForm()
    {
        var allForms = Database.GetAllForms();        

        var formData = new Form
        {
            Id = Guid.Empty,
            Name = _form.Name,
            Controls = new List<FormControl>()
        };

        if (_form.Id == Guid.Empty)
        {

            foreach (var control in _form.Controls)
            {
                var formControlData = new FormControl

                {
                    Id = Guid.Empty,
                    FormId = formData.Id,
                    Type = control.Type,
                    Parameters = (control.ControlReference.Instance as IFormControlSerializer).Serialize()
                };

                formData.Controls.Add(formControlData);
            }

            Database.Add(formData);

            _form.Id = formData.Id;

            for (var x = 0; x < _form.Controls.Count; x++)
            {
                _form.Controls[x].Id = formData.Controls[x].Id;
                _form.Controls[x].FormId = formData.Controls[x].FormId;
            }

            var newForm = _formsList.FirstOrDefault(x => x.Id == Guid.Empty);
            if (newForm != null)
                newForm.Id = formData.Id;

            //_formsList.Add(formData);
        }
        else
        {
            formData.Id = _form.Id;
            formData.Name = _form.Name;

            foreach (var control in _form.Controls)
            {
                var formControlData = new FormControl

                {
                    Id = Guid.Empty,
                    FormId = formData.Id,
                    Type = control.Type,
                    Parameters = (control.ControlReference.Instance as IFormControlSerializer).Serialize()
                };

                formData.Controls.Add(formControlData);
            }

            Database.Update(formData);
        }

    }

    private void AddForm()
    {
        var name = $"New Form {_forms.Count + 1}";
        _form = new ViewModels.Form
        {
            Id = Guid.Empty,
            Name = name,
            Controls = new List<ViewModels.FormControl>()
        };

        _forms.Add(_form);

        _formsList.Add(new Form { Name = _form.Name });
    }

    private void LoadForm(Form form)
    {
        var formData = Database.GetFormById(form.Id);

        if(formData == null)
            return;
        
        _form = new ViewModels.Form
        {
            Id = formData.Id,
            Name = formData.Name,
            Controls = null
        };

        var tempForm = new ViewModels.Form
        {
            Id = formData.Id,
            Name = formData.Name,
            Controls = new List<ViewModels.FormControl>()
        };

        foreach (var control in formData.Controls)
        {
            var formControl = new ViewModels.FormControl
            {
                Id = control.Id,
                FormId = control.FormId,
                Type = control.Type,
                Parameters = TextInput.Deserialize(control.Parameters)
            };
            tempForm.Controls.Add(formControl);
        }

        _form = tempForm;
    }
}