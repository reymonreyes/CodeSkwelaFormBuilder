@page "/"

<PageTitle>Blazor Form Builder</PageTitle>

<MudGrid>
    <MudItem sm="3" md="3" lg="3">
        <MudList T="string">
            <MudListItem Text="Textbox" Icon="@Icons.Material.Filled.Input" OnClick="AddTextbox" />
        </MudList>
    </MudItem>
    <MudItem sm="9" md="9" lg="9">
        @foreach (var element in formElements)
        {
            <MudStack>
                @element             
            </MudStack>
        }
    </MudItem>
</MudGrid>
@{
    
}

@code{

    private List<RenderFragment> formElements = new List<RenderFragment>();


    private void AddTextbox()
    {
        var elementCount = formElements.Count == 0 ? 1 : formElements.Count + 1;

        formElements.Add(renderBuilder =>
        {
            renderBuilder.OpenComponent(0, typeof(MudText));
            renderBuilder.AddAttribute(1, nameof(MudText.ChildContent), (RenderFragment)(builder => builder.AddContent(3, "Label")));
            renderBuilder.CloseComponent();
            renderBuilder.OpenComponent(4, typeof(MudTextField<string>));
            renderBuilder.CloseComponent();
        });

        //my first attempt        
        //formElements.Add(@<MudTextField T="string" Label="Label" />);
    }
}